<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Microphone for voice commands -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Phone / Call management -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Contacts for "call John" -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Notifications for reading alerts -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Accessibility for WhatsApp & UI automation -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />

    <!-- Notification listener to read messages -->
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" />

    <!-- Media controls -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />

    <!-- Flashlight / Torch -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- Alarms, Calendar, Reminders -->
    <uses-permission android:name="android.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Foreground service for always-on listening -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Keep CPU alive during screen-off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Overlay for action feedback bubbles -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Vibration feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Required for BootReceiver to receive BOOT_COMPLETED -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HeyGalaxy"
        tools:targetApi="34">

        <!-- Main UI Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Permissions Setup Activity -->
        <activity
            android:name=".ui.PermissionsActivity"
            android:exported="false"
            android:theme="@style/Theme.HeyGalaxy" />

        <!-- Always-on foreground voice service -->
        <service
            android:name=".service.VoiceListenerService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Notification reader -->
        <service
            android:name=".service.NotificationService"
            android:exported="true"
            android:label="Hey Galaxy Notifications"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Accessibility service (WhatsApp automation) -->
        <service
            android:name=".service.GalaxyAccessibilityService"
            android:exported="true"
            android:label="Hey Galaxy"
            android:permission="android.accessibilityservice.AccessibilityService">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Auto-start on boot -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Incoming call announcer -->
        <receiver
            android:name=".service.CallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
